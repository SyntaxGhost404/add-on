          "rotation": [
            28.0,
            0,
            0
          ]
        },
        "rightArm": {
          "rotation": [
            -38.0,
            -20.0,
            8.0
          ]
        },
        "leftArm": {
          "rotation": [
            -38.0,
            20.0,
            -8.0
          ]
        },
        "body": {
          "rotation": [
            6.0,
            0,
            0
          ]
        }
      }
    },
    "animation.rotu.graven_sentinel.move": {
      "loop": true,
      "bones": {
        "rightLeg": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17 * 0.7) * 24.0 * query.modified_move_speed",

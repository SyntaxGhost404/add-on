{
  "namespace": "server_form",

  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "enchant_plus_form_factory": {
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@server_form.enchant_plus_long_form",
                  "custom_form": "@server_form.enchant_plus_custom_form"
                }
              }
            }
          }
        ]
      }
    ]
  },

  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - '§d§a§e§p§r') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },

  "custom_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - '§d§a§e§p§r') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },

  "enchant_plus_long_form@common_dialogs.main_panel_no_buttons": {
    "$title_panel": "common_dialogs.standard_title_label",
    "$title_size": ["100% - 15px", 10],
    "$title_max_size": ["100% - 15px", 10],
    "$title_text_color": [1.0, 0.82, 0.32],
    "$custom_background": "enchant_plus.dialog_background",
    "size": [250, 210],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$child_control": "server_form.long_form_panel",
    "layer": 2,
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§d§a§e§p§r') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  "enchant_plus_custom_form@common_dialogs.main_panel_no_buttons": {
    "$title_panel": "common_dialogs.standard_title_label",
    "$title_size": ["100% - 15px", 10],
    "$title_max_size": ["100% - 15px", 10],
    "$title_text_color": [1.0, 0.82, 0.32],
    "$custom_background": "enchant_plus.dialog_background",
    "size": [250, 210],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$child_control": "server_form.custom_form_panel",
    "layer": 2,
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§d§a§e§p§r') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  }
}

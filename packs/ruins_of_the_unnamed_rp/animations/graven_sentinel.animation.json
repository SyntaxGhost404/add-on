{
  "format_version": "1.10.0",
  "animations": {
    "animation.rotu.graven_sentinel.look": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.variant == 0 ? 0 : query.target_x_rotation",
            "query.variant == 0 ? 0 : query.target_y_rotation",
            0
          ]
        }
      }
    },
    "animation.rotu.graven_sentinel.dormant": {
      "loop": true,
      "bones": {

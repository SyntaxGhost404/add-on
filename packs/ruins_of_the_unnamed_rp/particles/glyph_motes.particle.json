{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "rotu:glyph_motes",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/rotu/particle/mote"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.random_integer(6, 10)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.55,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.2, 2.0)"
      },
      "minecraft:particle_initial_speed": 0.15,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.35,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.07 + v.particle_random_1 * 0.05",
          "0.07 + v.particle_random_1 * 0.05"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#FF9BE9DE",
            "0.6": "#FF55C2B9",
            "1.0": "#002F8F8A"
          },
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}

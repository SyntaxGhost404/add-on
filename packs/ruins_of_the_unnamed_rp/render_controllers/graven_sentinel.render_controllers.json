{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.rotu.graven_sentinel": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.rotu.graven_sentinel_glow": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.glow"
      ],
      "ignore_lighting": true,
      "part_visibility": [
        {
          "*": "query.variant == 1 && !query.is_invisible"
        }
      ]
    }
  }
}

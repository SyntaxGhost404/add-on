          ]
        },
        "rightArm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17 * 0.7 + 180.0) * 16.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leftArm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17 * 0.7) * 16.0 * query.modified_move_speed",
